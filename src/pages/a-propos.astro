---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import { Image } from 'astro:assets';
import sebPhoto from '../assets/sebPhoto.png'; // Import de l'image locale

// Filtrer les membres de l'équipe avec 'draft: false' & une date antérieure à la date actuelle
const publishedTeamMembers = await getCollection("team", ({ data }) => {
  return !data.draft && data.publishDate < new Date();
});
---

<Layout title="À propos de RT Informatique — Expert informatique Gas, Maintenon" description="RT Informatique, société de services informatiques basée à Gas (28320) près de Maintenon. Sébastien DOS REIS, votre expert informatique local en Eure-et-Loir et Yvelines.">
  <Container>
    <Sectionhead>
      <Fragment slot="title">À propos</Fragment>
    </Sectionhead>

    <div class="flex flex-col gap-3 mx-auto max-w-4xl mt-16">
      <h2 class="font-bold text-3xl text-gray-800">
        À propos de RT Informatique
      </h2>
      <p class="text-lg leading-relaxed text-slate-500">
        RT Informatique est une société spécialisée dans les solutions informatiques, autant pour les particuliers que pour les entreprises. Nous vous accompagnons avec des solutions innovantes, pratiques et accessibles pour améliorer votre productivité, sécuriser vos données et optimiser vos performances.
      </p>

      <h2 class="font-bold text-3xl text-gray-800">
        Notre Mission
      </h2>
      <p class="text-lg leading-relaxed text-slate-500">
        Chez RT Informatique, notre mission est de simplifier la technologie pour tous. Que vous soyez un professionnel ou un particulier, nous sommes là pour vous offrir des solutions adaptées à vos besoins spécifiques.
      </p>

      <h2 class="font-bold text-3xl text-gray-800">
        Notre Engagement
      </h2>
      <p class="text-lg leading-relaxed text-slate-500">
        Notre approche est basée sur la transparence, l'écoute et un service client irréprochable. Nous nous engageons à fournir des solutions informatiques de qualité tout en maintenant une relation de confiance avec nos clients.
      </p>

      <h2 class="font-bold text-3xl text-gray-800">
        Pourquoi nous choisir ?
      </h2>
      <ul class="list-disc pl-5 text-lg leading-relaxed text-slate-500">
        <li>Expertise éprouvée dans le domaine de l’informatique.</li>
        <li>Solutions personnalisées adaptées à vos besoins spécifiques.</li>
        <li>Support technique réactif et disponible.</li>
        <li>Engagement envers l’innovation et l’efficacité.</li>
      </ul>

      <h2 class="font-bold text-3xl text-gray-800 mt-8">
        Notre zone d’intervention
      </h2>
      <p class="text-lg leading-relaxed text-slate-500">
        Basés à <strong>Gas (28320)</strong>, nous intervenons dans un rayon de 30 km autour de notre siège, en <strong>Eure-et-Loir (28)</strong> et en <strong>Yvelines (78)</strong>.
      </p>
      <ul class="list-disc pl-5 text-lg leading-relaxed text-slate-500">
        <li>Gas — siège social</li>
        <li>Maintenon</li>
        <li>Épernon</li>
        <li>Chartres</li>
        <li>Rambouillet</li>
        <li>Gallardon</li>
        <li>Nogent-le-Roi</li>
        <li>Auneau</li>
        <li>Et toutes les communes dans un rayon de 30 km en Eure-et-Loir (28) et Yvelines (78)</li>
      </ul>
      <p class="text-lg leading-relaxed text-slate-500">
        Vous avez un doute sur notre zone de couverture ? <a href="/contact" class="text-black underline hover:text-gray-600">Contactez-nous</a>, nous ferons tout notre possible pour intervenir chez vous.
      </p>
    </div>

    <div class="text-center mt-12">
      <a href="/contact" class="inline-block px-8 py-4 bg-black text-white rounded-lg font-semibold hover:bg-gray-800 transition">
        Contactez-nous
      </a>
    </div>
  </Container>
</Layout>
