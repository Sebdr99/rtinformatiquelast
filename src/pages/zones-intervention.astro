---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";

const zones = [
  { name: "Gas", distance: "Siège social — 28320 Eure-et-Loir", link: null },
  { name: "Maintenon", distance: "~5 km", link: null },
  { name: "Épernon", distance: "~12 km", link: null },
  { name: "Pierres", distance: "~8 km", link: null },
  { name: "Saint-Piat", distance: "~10 km", link: null },
  { name: "Gallardon", distance: "~15 km", link: null },
  { name: "Nogent-le-Roi", distance: "~18 km", link: null },
  { name: "Hanches", distance: "~14 km", link: null },
  { name: "Auneau", distance: "~22 km", link: null },
  { name: "Chartres", distance: "~28 km", link: null },
  { name: "Rambouillet", distance: "~25 km (78)", link: null },
  { name: "Ablis", distance: "~27 km (78)", link: null },
  { name: "Houdan", distance: "~30 km (78)", link: null },
];
---

<Layout
  title="Zones d'intervention — RT Informatique"
  description="RT Informatique intervient dans un rayon de 30km autour de Gas (28320) : Maintenon, Chartres, Rambouillet, Épernon, Gallardon, Nogent-le-Roi, Auneau, Ablis, Houdan, Pierres, Saint-Piat et toutes les communes environnantes.">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Zones d'intervention</Fragment>
      <Fragment slot="desc">
        RT Informatique intervient dans un rayon de 30 km autour de <strong>Gas (28320)</strong>, en <strong>Eure-et-Loir (28)</strong> et en <strong>Yvelines (78)</strong>. Dépannage, assistance, création de sites internet et vente de matériel — nous nous déplaçons chez vous.
      </Fragment>
    </Sectionhead>

    <div class="mx-auto max-w-4xl mt-12">
      <h2 class="font-bold text-2xl text-gray-800 mb-6">Communes couvertes</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {zones.map((zone) => (
          <div class="flex flex-col border border-gray-200 rounded-lg p-5 bg-gray-50 hover:bg-white transition">
            <span class="font-bold text-gray-800 text-lg">{zone.name}</span>
            <span class="text-slate-500 text-sm mt-1">{zone.distance}</span>
          </div>
        ))}
      </div>

      <div class="mt-10 bg-black text-white rounded-lg p-8 text-center">
        <h3 class="font-bold text-2xl mb-3">Votre commune n'est pas listée ?</h3>
        <p class="text-slate-300 mb-6">
          Cette liste n'est pas exhaustive. Nous étudions chaque demande d'intervention. Contactez-nous pour savoir si nous pouvons intervenir près de chez vous.
        </p>
        <a
          href="/contact"
          class="inline-block px-8 py-4 bg-white text-black rounded-lg font-semibold hover:bg-gray-100 transition">
          Nous contacter
        </a>
      </div>

      <div class="mt-10">
        <h2 class="font-bold text-2xl text-gray-800 mb-4">Notre secteur géographique</h2>
        <p class="text-slate-500 text-lg leading-relaxed">
          Basés à <strong>Gas</strong>, au cœur du département d'<strong>Eure-et-Loir (28)</strong>, nous couvrons l'ensemble des communes situées dans un rayon de 30 km, incluant une partie des <strong>Yvelines (78)</strong>. Notre connaissance du territoire local nous permet d'intervenir rapidement et efficacement, que ce soit pour un dépannage urgent ou une mission planifiée.
        </p>
        <p class="text-slate-500 text-lg leading-relaxed mt-4">
          Nous proposons aussi des interventions <strong>à distance</strong> pour tous nos clients, quelle que soit leur localisation en France.
        </p>
      </div>

      <div class="mt-10 grid sm:grid-cols-3 gap-6 text-center">
        <div class="border border-gray-200 rounded-lg p-6">
          <div class="text-3xl font-bold text-gray-800 mb-2">30 km</div>
          <div class="text-slate-500 text-sm">Rayon d'intervention sur site</div>
        </div>
        <div class="border border-gray-200 rounded-lg p-6">
          <div class="text-3xl font-bold text-gray-800 mb-2">2 dép.</div>
          <div class="text-slate-500 text-sm">Eure-et-Loir (28) &amp; Yvelines (78)</div>
        </div>
        <div class="border border-gray-200 rounded-lg p-6">
          <div class="text-3xl font-bold text-gray-800 mb-2">France</div>
          <div class="text-slate-500 text-sm">Dépannage à distance partout</div>
        </div>
      </div>
    </div>
  </Container>
</Layout>
