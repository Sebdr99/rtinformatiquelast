---
// @ts-ignore
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "Maintenance préventive",
    description:
      "Mises à jour régulières, nettoyage système, optimisation des performances. On intervient avant que les problèmes arrivent.",
    icon: "bx:bxs-wrench",
  },
  {
    title: "Cybersécurité & RGPD",
    description:
      "Antivirus managé, pare-feu, sensibilisation phishing et conformité RGPD. Vos données et celles de vos clients sont protégées.",
    icon: "bx:bx-shield",
  },
  {
    title: "Monitoring 24/7",
    description:
      "Surveillance en temps réel de vos serveurs et postes. On est alerté avant vous en cas d'anomalie, sans attendre vos signalements.",
    icon: "bx:bxs-dashboard",
  },
  {
    title: "Microsoft 365 & Cloud",
    description:
      "Migration, administration et formation sur Microsoft 365. On gère vos licences, vos accès et sécurise vos données dans le cloud.",
    icon: "bx:bxl-microsoft",
  },
  {
    title: "Support & dépannage illimité",
    description:
      "Un seul numéro à appeler. Support téléphonique, à distance ou sur site selon l'urgence. Pas de facturation à l'acte surprise.",
    icon: "bx:bx-headphone",
  },
  {
    title: "Plan de reprise d'activité",
    description:
      "Sauvegardes automatisées et vérifiées, procédures de restauration testées. Votre activité reprend rapidement après tout incident.",
    icon: "bx:bx-data",
  },
];
---

<div class="grid sm:grid-cols-2 md:grid-cols-3 mt-16 gap-16">
  {
    features.map((item) => (
      <div class="flex gap-4 items-start">
        <div class="mt-1 bg-black rounded-full p-2 w-8 h-8 shrink-0">
          <Icon class="text-white" name={item.icon} />
        </div>
        <div>
          <h3 class="font-semibold text-lg">{item.title}</h3>
          <p class="text-slate-500 mt-2 leading-relaxed">{item.description}</p>
        </div>
      </div>
    ))
  }
</div>
